{
  "name": "today-weather-quality",
  "private": true,
  "scripts": {
    "build:seo": "node scripts/generate-city-pages.mjs",
    "validate": "npm run build:seo && npm run test:city-weather-api && npm run test:specialized-weather && node scripts/validate-site.mjs && node scripts/audit-resources.mjs",
